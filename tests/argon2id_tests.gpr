with "config/argon2id_tests_config.gpr";
with "argon2id.gpr";

project Argon2id_Tests is

   for Languages use ("Ada", "C");
   for Source_Dirs use ("src/", "ref/", "config/");
   for Create_Missing_Dirs use "True";
   for Object_Dir use "obj/" & Argon2id_Tests_Config.Build_Profile;
   for Exec_Dir use "bin/";
   for Main use ("test_main.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        Argon2id_Tests_Config.Ada_Compiler_Switches &
        ("-gnatW8", "-gnatwa", "-gnatw.X", "-gnatwe", "-gnata");
      for Default_Switches ("C") use ("-O3", "-std=c11", "-Wall", "-Wextra");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

end Argon2id_Tests;
