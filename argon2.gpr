with "config/argon2_config.gpr";
with "blake2b.gpr";

project Argon2 is

   for Library_Name use "Argon2";
   for Library_Kind use "static";
   for Languages use ("Ada");
   for Source_Dirs use ("src/", "config/");
   for Create_Missing_Dirs use "True";
   for Object_Dir use "obj/" & Argon2_Config.Build_Profile;
   for Library_Dir use "lib/" & Argon2_Config.Build_Profile;

   package Compiler is
      for Default_Switches ("Ada") use
        Argon2_Config.Ada_Compiler_Switches &
        ("-gnatW8", "-gnatwa", "-gnatw.X", "-gnatwe");
      --  H0 copies each input into a local chunk with a byte loop. At -O3
      --  GCC turns that loop into a call of memcpy, which would copy the
      --  password, salt, secret and associated data through libc, outside
      --  the scrubbed frame of Argon2.H0.Compute
      --  (scripts/check-h0-object.sh fails on it).
      for Switches ("argon2-h0.adb") use
        Argon2_Config.Ada_Compiler_Switches &
        ("-gnatW8", "-gnatwa", "-gnatw.X", "-gnatwe",
         "-fno-tree-loop-distribute-patterns");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Prove is
      for Proof_Switches ("Ada") use
        ("--mode=all",
         "--checks-as-errors=on",
         "--proof-warnings=on",
         "--warnings=error",
         "--prover=z3,cvc5,altergo",
         "--timeout=0",
         "--steps=200000",
         "--counterexamples=off",
         "--report=fail");
      --  The H0 model and client are split into small proof contexts, so
      --  they are held to a stricter budget than the default.
      for Proof_Switches ("argon2-h0_model.adb") use ("--steps=10000");
      for Proof_Switches ("argon2-h0.adb") use ("--steps=10000");
      --  The same for compression and its model: every check proves in
      --  1637 steps with its cheapest prover, so 10000 leaves a sixfold
      --  margin (a check is proved when any one prover proves it within
      --  the budget).
      for Proof_Switches ("argon2-compression.adb") use ("--steps=10000");
      for Proof_Switches ("argon2-compression_model.ads")
        use ("--steps=10000");
      --  H': every check proves in 3700 steps with its cheapest prover, so
      --  10000 leaves a margin of 2.7.
      for Proof_Switches ("argon2-h_prime.adb") use ("--steps=10000");
      for Proof_Switches ("argon2-h_prime_model.ads") use ("--steps=10000");
      --  Geometry and the indexing model: every check proves in at most 2
      --  steps with its cheapest prover (almost always Z3). Each prover
      --  alone, the model's dearest check takes 2 steps with Z3, 2701 with
      --  CVC5 and 8282 with Alt-Ergo, so 10000 still covers every prover.
      for Proof_Switches ("argon2-geometry.adb") use ("--steps=10000");
      for Proof_Switches ("argon2-indexing_model.adb") use ("--steps=10000");
      --  Indexing: every check proves in at most 682 steps with its
      --  cheapest prover, so 10000 leaves a margin of 14. Each prover
      --  alone, the dearest check it proves takes 1468 steps with Z3, 4843
      --  with CVC5 and 5548 with Alt-Ergo.
      for Proof_Switches ("argon2-indexing.adb") use ("--steps=10000");
   end Prove;

end Argon2;
