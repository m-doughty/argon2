with "config/argon2id_config.gpr";
with "blake2b.gpr";

project Argon2id is

   for Library_Name use "Argon2id";
   for Library_Kind use "static";
   for Languages use ("Ada");
   for Source_Dirs use ("src/", "config/");
   for Create_Missing_Dirs use "True";
   for Object_Dir use "obj/" & Argon2id_Config.Build_Profile;
   for Library_Dir use "lib/" & Argon2id_Config.Build_Profile;

   package Compiler is
      for Default_Switches ("Ada") use
        Argon2id_Config.Ada_Compiler_Switches &
        ("-gnatW8", "-gnatwa", "-gnatw.X", "-gnatwe");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Prove is
      for Proof_Switches ("Ada") use
        ("--mode=all",
         "--checks-as-errors=on",
         "--proof-warnings=on",
         "--warnings=error",
         "--prover=z3,cvc5,altergo",
         "--timeout=0",
         "--steps=200000",
         "--counterexamples=off",
         "--report=fail");
      --  The H0 model and client are split into small proof contexts, so
      --  they are held to a stricter budget than the default.
      for Proof_Switches ("argon2id-h0_model.adb") use ("--steps=10000");
      for Proof_Switches ("argon2id-h0.adb") use ("--steps=10000");
   end Prove;

end Argon2id;
