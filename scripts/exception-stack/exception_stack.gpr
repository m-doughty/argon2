--  The measurement driver of scripts/check-exception-stack.sh. The script
--  builds it, in a scratch directory, against a copy of the library and of
--  its BLAKE2b dependency; it is not part of the library.

with "config/exception_stack_config.gpr";
with "argon2.gpr";

project Exception_Stack is

   for Languages use ("Ada");
   for Source_Dirs use ("src/");
   for Create_Missing_Dirs use "True";
   for Object_Dir use "obj/" & Exception_Stack_Config.Build_Profile;
   for Exec_Dir use "bin/";
   for Main use ("exception_stack.adb", "abort_stack.adb");

   --  The same switches in every profile: the driver's own code is not
   --  what is measured (the library units keep their profile's switches).
   package Compiler is
      for Default_Switches ("Ada") use
        ("-O2", "-gnat2022", "-gnatW8", "-gnatwa", "-gnatw.X", "-gnatwe");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

end Exception_Stack;
